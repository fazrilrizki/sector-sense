# ==========================================
# Supabase Configuration
# ==========================================
# Dapatkan kredensial ini dari Supabase Dashboard:
# Project Settings -> API (atau Project Settings -> Configuration -> API)

# URL Project Supabase Anda
# Contoh: https://xyzcompanyproject.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) Key
# Aman digunakan di browser client; dibatasi oleh Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role (secret) Key
# PERINGATAN: JANGAN PERNAH mengekspos key ini ke browser atau client!
# Digunakan HANYA di lingkungan server (cron jobs, seeding, backend scripts) untuk bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ==========================================
# Sectors Financial API Configuration
# ==========================================
# Dapatkan API key dari Sectors Dashboard (https://sectors.app/api)
SECTORS_API_KEY=your_sectors_api_key_here
SECTORS_API_BASE_URL=https://api.sectors.app/v2
SECTORS_MCP_URL=https://sectors-mcp.supertype.ai/mcp

# ==========================================
# Upstash Redis Cache Configuration (Opsional)
# ==========================================
# Jika diisi, client Sectors akan menggunakan Upstash Redis terdistribusi untuk caching.
# Jika dikosongkan, sistem akan otomatis fallback ke Next.js Data Cache / In-Memory Cache.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ==========================================
# Offline / Mock Mode Configuration
# ==========================================
# Set to true to enable Mock API mode (Auto USE & RECORD).
# Jika true, sistem akan membaca dari lib/data/api-mock-db.json. 
# Jika datanya belum ada, sistem akan memanggil API asli lalu menyimpannya ke file tersebut.
MOCK_API=true

# ==========================================
# Guest Search Quota & Cache Configuration
# ==========================================
# Batas maksimal pencarian emiten baru untuk pengguna tamu (default: 3)
NEXT_PUBLIC_GUEST_MAX_SEARCHES=3

# Durasi masa aktif cache pencarian emiten dalam detik (default: 21600 = 6 jam)
# Pencarian ulang emiten yang sama dalam rentang waktu ini tidak mengurangi kuota tamu.
NEXT_PUBLIC_GUEST_SEARCH_TTL_SECONDS=21600


# ==========================================
# LLM Provider Configuration
# ==========================================
# Pilih provider LLM yang akan digunakan (anthropic, google, openai)
LLM_PROVIDER=anthropic

# API Keys untuk masing-masing provider (isi sesuai dengan yang Anda gunakan)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

