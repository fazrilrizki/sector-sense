# ==========================================
# Supabase Configuration
# ==========================================
# Dapatkan kredensial ini dari Supabase Dashboard:
# Project Settings -> API (atau Project Settings -> Configuration -> API)

# URL Project Supabase Anda
# Contoh: https://xyzcompanyproject.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (public) Key
# Aman digunakan di browser client; dibatasi oleh Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role (secret) Key
# PERINGATAN: JANGAN PERNAH mengekspos key ini ke browser atau client!
# Digunakan HANYA di lingkungan server (cron jobs, seeding, backend scripts) untuk bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
